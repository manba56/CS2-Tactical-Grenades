    },
    {
      "id": "pw000000000004",
      "type": "text",
      "x": 960,
      "y": 260,
      "width": 340,
      "height": 55,
      "text": "**TacticDetailView** /tactics/:slug\n战术详情: 步骤+线路+路线图+收藏",
      "color": "#4a9eff"
    },
    {
      "id": "pw000000000005",
      "type": "text",
      "x": 960,
      "y": 340,
      "width": 340,
      "height": 55,
      "text": "**FavoritesView** /favorites\n我的收藏+最近浏览 (需登录)",
      "color": "#4a9eff"
    },
    {
      "id": "pw000000000006",
      "type": "text",
      "x": 960,
      "y": 420,
      "width": 340,
      "height": 55,
      "text": "**LoginView** /login\n玩家登录/注册",
      "color": "#4a9eff"
    },
    {
      "id": "pa000000000001",
      "type": "text",
      "x": 960,
      "y": 580,
      "width": 340,
      "height": 55,
      "text": "**LoginView** /admin/login\n管理员登录",
      "color": "#ff7a18"
    },
    {
      "id": "pa000000000002",
      "type": "text",
      "x": 960,
      "y": 660,
      "width": 340,
      "height": 55,
      "text": "**MapsAdminView** /admin/maps\n地图管理: 创建/编辑地图",
      "color": "#ff7a18"
    },
    {
      "id": "pa000000000003",
      "type": "text",
      "x": 960,
      "y": 740,
      "width": 340,
      "height": 55,
      "text": "**PointsAdminView** /admin/points\n点位管理: 在地图上标注点位",
      "color": "#ff7a18"
    },
    {
      "id": "pa000000000004",
      "type": "text",
      "x": 960,
      "y": 820,
      "width": 340,
      "height": 55,
      "text": "**LineupsAdminView** /admin/lineups\n线路管理: 创建/编辑投掷线路",
      "color": "#ff7a18"
    },
    {
      "id": "pa000000000005",
      "type": "text",
      "x": 960,
      "y": 900,
      "width": 340,
      "height": 55,
      "text": "**TacticsAdminView** /admin/tactics\n战术管理: 编排步骤+路线+截图",
      "color": "#ff7a18"
    },
    {
      "id": "pa000000000006",
      "type": "text",
      "x": 960,
      "y": 980,
      "width": 340,
      "height": 55,
      "text": "**AssetsAdminView** /admin/assets\n资源管理: 上传图片素材",
      "color": "#ff7a18"
    },
    {
      "id": "pa000000000007",
      "type": "text",
      "x": 960,
      "y": 1060,
      "width": 340,
      "height": 55,
      "text": "**UsersAdminView** /admin/users\n用户管理: 查看玩家列表",
      "color": "#ff7a18"
    }
