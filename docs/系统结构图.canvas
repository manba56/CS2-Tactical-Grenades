      "y": -30,
      "width": 400,
      "height": 530,
      "label": "cs2-web (玩家端页面)",
      "color": "5"
    },
    {
      "id": "grpadmpage00001",
      "type": "group",
      "x": 930,
      "y": 530,
      "width": 400,
      "height": 620,
      "label": "cs2-admin (管理后台页面)",
      "color": "2"
    },
    {
      "id": "ap000000000001",
      "type": "text",
      "x": 20,
      "y": 20,
      "width": 390,
      "height": 65,
      "text": "**GET /api/public/home**\n首页数据 → 返回 maps + tactics + lineups 汇总",
      "color": "#4a9eff"
    },
    {
      "id": "ap000000000002",
      "type": "text",
      "x": 20,
      "y": 100,
      "width": 390,
      "height": 65,
      "text": "**GET /api/public/maps**, **/maps/{slug}**\n地图列表 + 地图详情(含 points, lineups, tactics)",
      "color": "#4a9eff"
    },
    {
      "id": "ap000000000003",
      "type": "text",
      "x": 20,
      "y": 180,
      "width": 390,
      "height": 65,
      "text": "**GET /api/public/tactics**, **/tactics/{slug}**\n战术列表(筛选/分页) + 战术详情(含 lineups, steps, routes)",
      "color": "#4a9eff"
    },
    {
      "id": "ap000000000004",
      "type": "text",
      "x": 20,
      "y": 260,
      "width": 390,
      "height": 65,
      "text": "**POST auth/register**, **auth/login**\n玩家注册 + 登录 → 签发 token",
      "color": "#4a9eff"
    },
    {
      "id": "ap000000000005",
      "type": "text",
      "x": 20,
      "y": 350,
      "width": 390,
      "height": 65,
      "text": "**GET /api/public/me/favorites**\n我的收藏 + 最近浏览记录",
      "color": "#4a9eff"
    },
    {
      "id": "ap000000000006",
      "type": "text",
      "x": 20,
      "y": 425,
      "width": 390,
      "height": 65,
      "text": "**POST/DELETE /api/public/me/favorites/{id}**\n添加/取消收藏",
      "color": "#4a9eff"
    },
    {
      "id": "ap000000000007",
      "type": "text",
      "x": 20,
      "y": 500,
      "width": 390,
      "height": 65,
      "text": "**POST /api/public/me/recent/{id}**\n记录最近浏览战术",
      "color": "#4a9eff"
    },
    {
      "id": "aa000000000001",
      "type": "text",
      "x": 20,
      "y": 670,
      "width": 390,
      "height": 65,
      "text": "**POST /api/admin/auth/login**\n管理员登录 → 签发 admin token",
      "color": "#ff7a18"
    },
    {
      "id": "aa000000000002",
      "type": "text",
      "x": 20,
      "y": 750,
      "width": 390,
      "height": 65,
      "text": "**GET /api/admin/dashboard**\n统计面板: maps/points/lineups/tactics/users 数量",
      "color": "#ff7a18"
    },
    {
      "id": "aa000000000003",
      "type": "text",
      "x": 20,
      "y": 830,
      "width": 390,
      "height": 65,
      "text": "**GET/POST/PUT /api/admin/maps**\n地图 CRUD: 列表/创建/更新",
      "color": "#ff7a18"
    },
    {
      "id": "aa000000000004",
      "type": "text",
      "x": 20,
      "y": 910,
      "width": 390,
      "height": 65,
      "text": "**GET/POST/PUT /api/admin/points**\n点位 CRUD: 列表/创建/更新(按 map_id 筛选)",
      "color": "#ff7a18"
    },
    {
      "id": "aa000000000005",
      "type": "text",
      "x": 20,
      "y": 990,
      "width": 390,
      "height": 65,
      "text": "**GET/POST/PUT /api/admin/lineups**\n投掷线路 CRUD: 列表/创建/更新",
      "color": "#ff7a18"
    },
    {
      "id": "aa000000000006",
      "type": "text",
      "x": 20,
      "y": 1070,
      "width": 390,
      "height": 65,
      "text": "**POST archive / DELETE /api/admin/lineups/{id}**\n归档线路 | 删除线路(检查战术引用)",
      "color": "#ff7a18"
    },
    {
      "id": "aa000000000007",
      "type": "text",
      "x": 20,
      "y": 1150,
      "width": 390,
      "height": 65,
      "text": "**GET/POST/PUT /api/admin/tactics**\n战术 CRUD: 列表/创建/更新(含 step_items, routes)",
      "color": "#ff7a18"
    },
    {
      "id": "aa000000000008",
      "type": "text",
      "x": 20,
      "y": 1230,
      "width": 390,
      "height": 65,
      "text": "**POST publish/archive /api/admin/tactics/{id}**\n发布战术 | 归档战术",
      "color": "#ff7a18"
    },
    {
      "id": "aa000000000009",
      "type": "text",
      "x": 20,
      "y": 1310,
      "width": 390,
      "height": 65,
      "text": "**GET /api/admin/users**\n玩家用户列表(含收藏数/浏览数统计)",
      "color": "#ff7a18"
    },
    {
      "id": "aa000000000010",
      "type": "text",
      "x": 20,
      "y": 1390,
      "width": 390,
      "height": 65,
      "text": "**POST /api/admin/assets**\n上传图片资源(≤20MB, 白名单校验)",
      "color": "#ff7a18"
    },
    {
      "id": "db000000000001",
      "type": "text",
      "x": 510,
      "y": 20,
      "width": 360,
      "height": 130,
      "text": "## maps (地图)\nname, slug, overview, cover_url, layout_url\nvideo_url, callout_color, order\nstatus [draft|published|archived]\nactive_pool [bool]",
      "color": "#4caf50"
    },
    {
      "id": "db000000000002",
      "type": "text",
      "x": 510,
      "y": 170,
      "width": 360,
      "height": 130,
      "text": "## points (点位)\nmap_id → **maps.id**\nname, key, x, y, side [T|CT|BOTH]\npoint_type [site|staging|aim|utility|anchor]\ntags [JSON]",
      "color": "#4caf50"
    },
    {
      "id": "db000000000003",
      "type": "text",
      "x": 510,
      "y": 320,
      "width": 360,
      "height": 150,
      "text": "## lineups (投掷线路)\nmap_id → **maps.id**\ntitle, slug, side, utility_type\nstart_point_id → **points.id**\naim_point_id → **points.id**\nland_point_id → **points.id**\npurpose, difficulty, summary\nsteps [JSON], media [JSON], video_url\nstatus [draft|published|archived]",
      "color": "#4caf50"
    },
    {
      "id": "db000000000004",
      "type": "text",
      "x": 510,
      "y": 490,
      "width": 360,
      "height": 150,
      "text": "## tactics (战术)\nmap_id → **maps.id**\ntitle, slug, side, goal, phase, difficulty\nplayers, summary, note, tags [JSON]\ncover_url, video_url, featured, status\ncreated_at\nstep_items [JSON: {order, role, type, lineup_id→**lineups.id**}]\nroutes [JSON], screenshots [JSON]",
      "color": "#4caf50"
    },
    {
      "id": "db000000000005",
      "type": "text",
      "x": 510,
      "y": 660,
      "width": 360,
      "height": 130,
      "text": "## users (用户)\nusername, email, password_hash, role [admin|player]\nfavorite_ids [JSON: 收藏的 tactic IDs]\nrecent_tactic_ids [JSON: 最近浏览的 tactic IDs]",
      "color": "#4caf50"
    },
    {
      "id": "db000000000006",
      "type": "text",
      "x": 510,
      "y": 810,
      "width": 360,
      "height": 100,
      "text": "## assets (资源文件)\nfilename, original_name, url\nwidth, height, type",
      "color": "#4caf50"
    },
    {
      "id": "db000000000007",
      "type": "text",
      "x": 510,
      "y": 930,
      "width": 360,
      "height": 85,
      "text": "## tokens (登录令牌)\nuser_id → **users.id**\ntoken_hash, created_at, expires_at",
      "color": "#4caf50"
    },
    {
      "id": "db000000000008",
      "type": "text",
      "x": 510,
      "y": 1035,
      "width": 360,
      "height": 85,
      "text": "## login_log (登录日志)\nuser_id → **users.id** (nullable)\nusername, ip, success, created_at",
      "color": "#4caf50"
    },
    {
      "id": "db000000000009",
      "type": "text",
      "x": 510,
      "y": 1140,
      "width": 360,
      "height": 65,
      "text": "## counters (ID计数器)\ntable_name, next_id",
      "color": "#4caf50"
    },
    {
      "id": "pw000000000001",
      "type": "text",
      "x": 960,
      "y": 20,
      "width": 340,
      "height": 55,
      "text": "**HomeView** /\n首页: 精选地图+战术+快捷入口",
      "color": "#4a9eff"
    },
    {
      "id": "pw000000000002",
      "type": "text",
      "x": 960,
      "y": 100,
      "width": 340,
      "height": 55,
      "text": "**MapsView** /maps\n地图列表页",
      "color": "#4a9eff"
    },
    {
      "id": "pw000000000003",
      "type": "text",
      "x": 960,
      "y": 180,
      "width": 340,
      "height": 55,
      "text": "**MapDetailView** /maps/:slug\n地图详情: 点位+线路+战术筛选",
