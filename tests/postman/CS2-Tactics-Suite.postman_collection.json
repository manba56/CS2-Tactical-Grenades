    {
      "name": "Me - Create Tactic Board",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Postman Mirage A execute\",\"map_id\":5,\"side\":\"T\",\"plan_type\":\"exec\",\"summary\":\"Window smoke, connector smoke, then split A.\",\"markers\":[{\"x\":18,\"y\":82,\"label\":\"P1\",\"role\":\"player\",\"side\":\"T\"},{\"x\":47,\"y\":37,\"label\":\"Window\",\"role\":\"smoke\",\"side\":\"BOTH\"}],\"routes\":[]}"
        },
        "url": "{{base_url}}/api/public/me/boards"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('board has map and markers', function () {",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body.map.slug).to.eql('mirage');",
              "  pm.expect(body.markers).to.be.an('array').that.is.not.empty;",
              "});",
              "pm.environment.set('board_id', body.id);"
            ]
          }
        }
      ]
    },
