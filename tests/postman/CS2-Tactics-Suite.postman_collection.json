    {
      "name": "Me - Update Tactic Board",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Postman Mirage A execute v2\",\"map_id\":5,\"side\":\"T\",\"plan_type\":\"exec\",\"summary\":\"Updated board from Postman.\",\"markers\":[{\"x\":18,\"y\":82,\"label\":\"P1\",\"role\":\"player\",\"side\":\"T\"},{\"x\":47,\"y\":37,\"label\":\"Window\",\"role\":\"smoke\",\"side\":\"BOTH\"},{\"x\":78,\"y\":41,\"label\":\"A hit\",\"role\":\"note\",\"side\":\"BOTH\"}],\"routes\":[]}"
        },
        "url": "{{base_url}}/api/public/me/boards/{{board_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('board was updated', function () {",
              "  pm.expect(body.title).to.include('v2');",
              "  pm.expect(body.markers.length).to.eql(3);",
              "});"
            ]
          }
        }
      ]
    },
