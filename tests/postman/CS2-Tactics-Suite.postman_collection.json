    {
      "name": "Me - Sync Local",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"favorite_lineup_ids\":[{{lineup_id}}],\"lineup_progress\":{\"{{lineup_id}}\":\"practicing\"},\"tactic_progress\":{\"{{tactic_id}}\":\"match_ready\"}}"
        },
        "url": "{{base_url}}/api/public/me/sync-local"
      },
      "event": [
        {
          "listen": "test",
          "script": {
