{
  "info": {
    "name": "CS2 Tactics Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('status is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Public - Home",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/public/home"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('has home sections', function () {",
              "  pm.expect(body).to.have.property('featured_maps');",
              "  pm.expect(body).to.have.property('featured_tactics');",
              "  pm.expect(body).to.have.property('latest_tactics');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Public - Maps",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/public/maps"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('maps is array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Public - Map Detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/public/maps/{{map_slug}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('has points and lineups', function () {",
              "  pm.expect(body).to.have.property('points');",
              "  pm.expect(body).to.have.property('lineups');",
              "});",
              "if (body.lineups && body.lineups.length > 0) { pm.environment.set('lineup_id', body.lineups[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Public - Tactics",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/public/tactics?page_size=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('has paginated items', function () {",
              "  pm.expect(body).to.have.property('items');",
              "  pm.expect(body.items).to.be.an('array');",
              "});",
              "if (body.items && body.items.length > 0) { pm.environment.set('tactic_id', body.items[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Player Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username_or_email\":\"{{username}}\",\"password\":\"{{password}}\"}"
        },
        "url": "{{base_url}}/api/public/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('has token', function () { pm.expect(body).to.have.property('token'); });",
              "pm.environment.set('token', body.token);"
            ]
          }
        }
      ]
    },
